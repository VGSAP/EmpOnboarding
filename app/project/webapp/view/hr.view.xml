<mvc:View
    controllerName="project.controller.hr"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page >
        
<customHeader >
        <Bar class="space">
            <contentLeft>
                <Title text="Employee Onboarding" />
            </contentLeft>
            <contentRight>
                <Button icon="sap-icon://home" tooltip="Dashboard"/>
                <Button icon="sap-icon://add" tooltip="Add Employee"/>
                <Button icon="sap-icon://accept" tooltip="Verify Documents"/>
            </contentRight>
        </Bar>
    </customHeader>


        <VBox class="dashboard-container">
            <!-- Page Title -->
            <VBox class="dashboard-header">
                <Title text="HR Dashboard" level="H1"/>
            </VBox>

            <!-- Stats Cards -->
            <HBox class="stats-grid">
                <VBox class="stat-card">
                    <VBox class="stat-card-header">
                        <Text text="Registered Members" class="stat-card-title"/>
                        <core:Icon src="sap-icon://employee" class="stat-card-icon"/>
                    </VBox>
                    <VBox class="stat-card-content">
                        <ObjectNumber number="{/stats/registeredMembers}" class="stat-card-value" unit="0"/>
                        <Text text="Total users in the system" class="stat-card-description"/>
                    </VBox>
                </VBox>

                <VBox class="stat-card">
                    <VBox class="stat-card-header">
                        <Text text="Pending Verifications" class="stat-card-title"/>
                        <core:Icon src="sap-icon://doc-attachment" class="stat-card-icon"/>
                    </VBox>
                    <VBox class="stat-card-content">
                        <ObjectNumber number="{/stats/pendingVerifications}" class="stat-card-value" unit="0"/>
                        <Text text="Documents awaiting manager approval" class="stat-card-description"/>
                    </VBox>
                </VBox>

                <VBox class="stat-card">
                    <VBox class="stat-card-header">
                        <Text text="New Hires (This Month)" class="stat-card-title"/>
                        <core:Icon src="sap-icon://group" class="stat-card-icon"/>
                    </VBox>
                    <VBox class="stat-card-content">
                        <ObjectNumber number="{/stats/newHiresThisMonth}" class="stat-card-value" unit="0"/>
                        <Text text="Employees joined in the current month" class="stat-card-description"/>
                    </VBox>
                </VBox>
            </HBox>

            <!-- Company Directory -->
            <VBox class="directory-card full-width">
                <VBox class="directory-card-header">
                    <Text text="Company Directory (from SAP CAPM)" class="directory-card-title"/>
                    <Text text="Employee data sourced from SAP Cloud Application Programming Model (Simulated)." class="directory-card-description"/>
                </VBox>
                <VBox class="directory-card-content employee-list-container">
                    <List items="{/employees}">
                        <CustomListItem class="employee-item">
                            <VBox>
                                <Text text="{name}" class="employee-name"/>
                                <Text text="{department}" class="employee-department"/>
                                <Text text="{email}" class="employee-email"/>
                            </VBox>
                        </CustomListItem>
                    </List>
                </VBox>
            </VBox>
        </VBox>
    </Page>
</mvc:View>
