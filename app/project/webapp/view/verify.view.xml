<mvc:View
    controllerName="project.controller.verify"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true">

    <Page title="Employee Document Verification">
        
        <customHeader>
            <Bar>
                <contentLeft>
                    <Title text="Verify Employee Documents"/>
                </contentLeft>
                <contentRight>
                    <Button icon="sap-icon://home" tooltip="Home" press=".onNavTohome" />
                    <Button text="Show Verified" press=".onFilterVerified" class="onFilterVerified"/>
                    <Button text="Show Rejected" press=".onFilterRejected" class="onFilterRejected"/>
                    <Button text="Show Pending" press=".onFilterPending" class="onFilterPending"/>
                </contentRight>
            </Bar>
        </customHeader>

        <VBox class="verification-container">
            <VBox class="verification-header">
                <Title text="Documents List" level="H1"/>
            </VBox>

            <!-- Employee Document List -->
            <List id="documentList" items="{path: '/EmployeeDetails'}" growing="true" growingScrollToLoad="true">
                <CustomListItem>
                    <VBox class="document-card">
                        <HBox class="document-card-header">
                            <Text text="{firstName} {lastName}" class="document-card-title"/>
                            <core:Icon src="sap-icon://doc-attachment" class="document-card-icon"/>
                        </HBox>
                        <VBox class="document-card-content">
                            <Text text="Document Type: {documentType}" class="document-detail"/>
                            <Text text="Submission Date: {submissionDate}" class="document-detail"/>
                            <Text text="Status: {status}" class="document-detail"/>
                            <HBox>
                                <Button text="Approve" type="Accept" press=".onApprove" class="approve-button"/>
                                <Button text="Reject" type="Reject" press=".onReject" class="reject-button"/>
                            </HBox>
                        </VBox>
                    </VBox>
                </CustomListItem>
            </List>
        </VBox>
        
    </Page>
</mvc:View>
