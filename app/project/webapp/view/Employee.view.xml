<mvc:View controllerName="project.controller.Employee"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout">
    <Page id="page" title="{i18n>title}">
    </Page>
   
<VBox justifyContent="Center" alignItems="Center" height="100%">
            <VBox width="300px" class="sapUiSmallMargin">
                <Label text="Email" />
                <Input id="emailInput" type="Email" />
               
                <Label text="Password" />
                <Input id="passwordInput" type="Password" />
               
                <CheckBox text="Remember Me" />
               
                <Button text="Login" press="onLoginPress" />
                <Button text="Continue with Google" press="onGoogleLoginPress" />
                <Button text="Continue with Facebook" press="onFacebookLoginPress" />
               
                <Link text="Forgot Password?" press="onForgotPasswordPress" />
                <Link text="Don't have an account? Register" press="onRegisterPress" />
            </VBox>
           
            <VBox width="300px" class="sapUiSmallMargin">
                <Image src="https://cdn.dribbble.com/userupload/12273158/file/original-6dc3100a407ebb9bd60d95e063c92bf6.png?resize=1024x768&vertical=center" />
                <!-- Add icons and other elements as needed -->
            </VBox>
</VBox>
 
</mvc:View>