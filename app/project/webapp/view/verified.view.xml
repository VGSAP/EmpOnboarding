<mvc:View
    controllerName="project.controller.verifiedDocuments"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    
    <Page title="Verified Documents">
        <VBox>
            <Title text="Verified Documents" level="H1"/>
            <List items="{/verifiedDocuments}">
                <CustomListItem>
                    <VBox>
                        <Text text="{employeeName}" class="document-name"/>
                        <Text text="Document Type: {documentType}" class="document-detail"/>
                        <Text text="Submission Date: {submissionDate}" class="document-detail"/>
                    </VBox>
                </CustomListItem>
            </List>
        </VBox>
    </Page>
</mvc:View>
