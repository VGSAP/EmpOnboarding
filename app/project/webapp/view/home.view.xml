<mvc:View controllerName="project.controller.home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page showHeader="false" class = "pgclass">

        <HBox class="pageContainer">
            
            <Image src="assets/planeimage.png" alt="Image" class="image"/>

            
                <VBox class="loginContainer" alignItems="Start" justifyContent="Center">
                    <Image src="https://campbuzz.ltimindtree.com/Images/ltimindtree.svg" alt="LTIMindtree Logo" class="logo"/>

                    <Label text="Email" class="requiredLabel"/>
                    <Input id="emailInput" type="Email" class="fullWidth"/>

                    <Label text="Password" class="requiredLabel"/>
                    <Input id="passwordInput" type="Password" class="fullWidth" showValueHelp="false" valueHelpIconSrc="sap-icon://show" valueHelpRequest="ontoggle" liveChange="onPasswordInputChange"/>
                    

                    <Button text="Login" press="onLogin" class="centeredButton"/>

                    <Link text="Don't have an account? Register" press="onOpenRegisterDialog" class="registerlink"/>
                </VBox>
            
        </HBox>

                <Dialog id="registerDialog" title="Register">
                    <VBox class="reg-form-container" alignItems="Start" justifyContent="Center">
                        <Label text="Full Name" class="reg-label"/>
                        <Input id="nameInput" class="reg-input"/>

                        <Label text="Mobile Number" class="reg-label"/>
                        <Input id="mobilenumber" class="reg-input"/>

                        <Label text="Email" class="reg-label"/>
                        <Input id="regEmailInput" type="Email" class="reg-input"/>

                        <Label text="Password" class="reg-label"/>
                        <Input id="regPasswordInput" type="Password" class="reg-input"/>

                        <Label text="Confirm Password" class="reg-label"/>
                        <Input id="confirmpass" type="Password" class="reg-input"/>

                        <CheckBox id="terms" text="I agree to the Terms &amp; Conditions" class="reg-checkbox"/>
                    </VBox>

                    <beginButton>
                        <Button text="Register" press="onRegister" class="reg-button reg-button"/>
                    </beginButton>

                    <endButton>
                        <Button text="Cancel" press="onCancelRegister" class="reg-button reg-button"/>
                    </endButton>
                    </Dialog>

    </Page>
</mvc:View>
