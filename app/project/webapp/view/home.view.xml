<mvc:View controllerName="project.controller.home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page class="background" showHeader="false">
        <HBox class="pageContainer">
            <VBox class="imageContainer">
                <Image src="https://campbuzz.ltimindtree.com/Images/Mask_Group.png" alt="Image"/>
            </VBox>

            <VBox class="loginSection" alignItems="Center" justifyContent="Center">
                <VBox class="loginContainer" alignItems="Start" justifyContent="Center">
                    <Image src="https://campbuzz.ltimindtree.com/Images/ltimindtree.svg" alt="LTIMindtree Logo" class="logo"/>
                    <Title text="Welcome to Onboarding Portal" class="pagetitle"></Title>
                    <Label text="Username" class="requiredLabel"/>
                    <Input id="emailInput" type="Email" class="fullWidth"/>
                    <Label text="Password" class="requiredLabel"/>
                    <Input id="passwordInput" type="Password" class="fullWidth"/>
                    <Button text="Login" press="onLogin" class="centeredButton"/>
                    <Link text="Don't have an account? Register" press="onOpenRegisterDialog"/>
                </VBox>
            </VBox>
        </HBox>

        <Dialog id="registerDialog" title="Register">
            <VBox class="registerContainer" alignItems="Start" justifyContent="Center">
                <Label text="Full Name" class="requiredLabel"/>
                <Input id="nameInput" class="fullWidth"/>

                <Label text="Mobile Number" class="requiredLabel"/>
                <Input id="mobilenumber"  class="fullWidth"/>

                <Label text="Email" class="requiredLabel"/>
                <Input id="regEmailInput" type="Email"  class="fullWidth"/>

                <Label text="Password" class="requiredLabel"/>
                <Input id="regPasswordInput" type="Password"  class="fullWidth"/>

                <Label text="Confirm Password" class="requiredLabel"/>
                <Input id="confirmpass" type="Password"  class="fullWidth"/>

                <CheckBox id="terms" text="I agree to above Terms &amp; Conditions"/>
            </VBox>
            <beginButton>
                <Button text="Register" press="onRegister" class="centeredButton"/>
            </beginButton>
            <endButton>
                <Button text="Cancel" press="onCancelRegister" class="centeredButton"/>
            </endButton>
        </Dialog>
    </Page>
</mvc:View>
