<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
    controllerName="project.controller.document">

    <Page title="Documents Upload">
        <content>
            <VBox alignItems="Center" justifyContent="Center" class="sapUiSmallMargin">
                <Title text="Upload Documents" class="sapUiSmallMarginBottom"/>

                <HBox class="formRow">
                    <Label text="Degree Certificate" class="formLabel"/>
                    <unified:FileUploader id="degreeDocument" icon="sap-icon://upload" iconOnly="false"  uploadUrl="/upload" change="onFileUpload" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Label text="High School Certificate" class="formLabel"/>
                    <unified:FileUploader id="highSchoolDocument" icon="sap-icon://upload" iconOnly="false"  uploadUrl="/upload" change="onFileUpload" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Label text="School Certificate" class="formLabel"/>
                    <unified:FileUploader id="schoolDocument" icon="sap-icon://upload" iconOnly="false" uploadUrl="/upload" change="onFileUpload" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Label text="Aadhar Card" class="formLabel"/>
                    <unified:FileUploader id="AadharDocument" icon="sap-icon://upload" iconOnly="false"  uploadUrl="/upload" change="onFileUpload" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Label text="Resume" class="formLabel"/>
                    <unified:FileUploader id="Resume" icon="sap-icon://upload" iconOnly="false"  uploadUrl="/upload" change="onFileUpload" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Button text="Previous" press="onPrevious" class="onbutton" width="120px"/>
                    <Button text="Submit" press="onsubmit" class="onbutton" width="120px"/>
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
