<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:unified="sap.ui.unified"
    controllerName="project.controller.document">

    <Page title="Documents Upload">
        <content>
            <VBox alignItems="Center" justifyContent="Center" class="sapUiSmallMargin">
                <Title text="Upload Documents" class="sapUiSmallMarginBottom"/>

                <HBox class="formRow">
                    <Label text="Upload Degree Certificate *" class="formLabel"/>
                    <unified:FileUploader id="degreeDocument" buttonText="Upload Document" uploadUrl="/upload" change="onFileUpload" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Label text="Upload High School Certificate *" class="formLabel"/>
                    <unified:FileUploader id="highSchoolDocument" buttonText="Upload Document" uploadUrl="/upload" change="onFileUpload" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Label text="Upload School Certificate *" class="formLabel"/>
                    <unified:FileUploader id="schoolDocument" buttonText="Upload Document" uploadUrl="/upload" change="onFileUpload" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Label text="Aadhar Card *" class="formLabel"/>
                    <unified:FileUploader id="AadharDocument" buttonText="Upload Document" uploadUrl="/upload" change="onFileUpload" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Label text="Upload Resume *" class="formLabel"/>
                    <unified:FileUploader id="Resume" buttonText="Upload Document" uploadUrl="/upload" change="onFileUpload" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Button text="Previous" press="onPrevious" class="sapUiSmallMarginTop sapUiSmallMarginEnd" width="120px"/>
                    <Button text="Submit" press="onsubmit" class="sapUiSmallMarginTop" width="120px"/>
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
