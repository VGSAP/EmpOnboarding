<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    controllerName="project.controller.employee">
    <Page title="Employee Onboarding">
        <content>
            <VBox alignItems="Center" justifyContent="Center" class="sapUiSmallMargin">
                <Title text="Personal Details" class="sapUiSmallMarginBottom"/>

                <!-- Each HBox contains one label and one input field -->
                <HBox class="formRow">
                    <Label text="First Name" class="formLabel"/>
                    <Input id="firstname" liveChange="onValidate" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Label text="Last Name" class="formLabel"/>
                    <Input id="lastname" liveChange="onValidate" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Label text="Date of Birth" class="formLabel"/>
                    <DatePicker id="dobPicker" liveChange="onValidateDOB" class="formInput" width="180px"/>
                </HBox>

                <HBox class="formRow">
                    <Label text="Email" class="formLabel"/>
                    <Input id="email" type="Email" liveChange="onValidateEmail" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Label text="Phone" class="formLabel"/>
                    <Input id="phoneInput" type="Tel" liveChange="onValidatePhone" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Label text="Select Gender" class="formLabel"/>
                    <ComboBox id="GenderComboBox" change="onValidate" class="formInput" width="180px">
                        <items>
                            <core:ListItem key="Female" text="Female"/>
                            <core:ListItem key="Male" text="Male"/>
                            <core:ListItem key="Other" text="Other"/>
                        </items>
                    </ComboBox>
                </HBox>

                <HBox class="formRow">
                    <Label text="Select Nationality" class="formLabel"/>
                    <ComboBox id="nationalityComboBox" change="onValidate" class="formInput" width="180px">
                        <items>
                            <core:ListItem key="Indian" text="Indian"/>
                            <core:ListItem key="American" text="American"/>
                            <core:ListItem key="British" text="British"/>
                            <core:ListItem key="Canadian" text="Canadian"/>
                            <core:ListItem key="Australian" text="Australian"/>
                        </items>
                    </ComboBox>
                </HBox>

                <HBox class="formRow">
                    <Label text="Address" class="formLabel"/>
                    <Input id="Address" liveChange="onValidate" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Label text="City" class="formLabel"/>
                    <Input id="City" liveChange="onValidate" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Label text="State" class="formLabel"/>
                    <Input id="State" liveChange="onValidate" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Label text="Country" class="formLabel"/>
                    <Input id="Country" liveChange="onValidate" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Label text="Zip Code" class="formLabel"/>
                    <Input id="ZipCode" liveChange="onValidateZip" class="formInput"/>
                </HBox>

                <Button text="Next" press="onNext" class="sapUiSmallMarginTop" width="150px"/>
            </VBox>
        </content>
    </Page>
</mvc:View>
