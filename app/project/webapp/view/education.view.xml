<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    controllerName="project.controller.education">

    <Page title="Education Details">
        <content>
            <VBox alignItems="Center" justifyContent="Center" class="sapUiSmallMargin">
                <Title text="Education Information" class="sapUiSmallMarginBottom"/>

                <HBox class="formRow">
                    <Label text="Highest Qualification" class="formLabel"/>
                    <ComboBox id="highestQualification" class="formInput" width="180px">
                        <items>
                            <core:Item key="Bachelor" text="Bachelor's Degree"/>
                            <core:Item key="Master" text="Master's Degree"/>
                            <core:Item key="PhD" text="PhD"/>
                            <core:Item key="Diploma" text="Diploma"/>
                        </items>
                    </ComboBox>
                </HBox>

                <HBox class="formRow">
                    <Label text="Branch" class="formLabel"/>
                    <ComboBox id="Branch" class="formInput" width="180px">
                        <items>
                            <core:Item key="Computer Science" text="Computer Science"/>
                            <core:Item key="Civil" text="Civil"/>
                            <core:Item key="Mechanical" text="Mechanical"/>
                            <core:Item key="Electrical" text="Electrical"/>
                        </items>
                    </ComboBox>
                </HBox>

                <HBox class="formRow">
                    <Label text="College/University" class="formLabel"/>
                    <Input id="collegeName" placeholder="Enter college/university name" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Label text="Percentage" class="formLabel"/>
                    <Input id="percentage" type="Number" placeholder="Enter percentage" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Label text="High School Stream" class="formLabel"/>
                    <ComboBox id="highSchoolStream" class="formInput" width="180px">
                        <items>
                            <core:Item key="MPC" text="MPC"/>
                            <core:Item key="BPC" text="BPC"/>
                        </items>
                    </ComboBox>
                </HBox>

                <HBox class="formRow">
                    <Label text="High School" class="formLabel"/>
                    <Input id="highSchool" placeholder="Enter high school name" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Label text="Percentage" class="formLabel"/>
                    <Input id="highSchoolPercentage" type="Number" placeholder="Enter percentage" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Label text="School " class="formLabel"/>
                    <Input id="school" placeholder="Enter school name" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Label text="Percentage " class="formLabel"/>
                    <Input id="schoolPercentage" type="Number" placeholder="Enter percentage" class="formInput"/>
                </HBox>

                <HBox class="formRow">
                    <Button text="Previous" press="onPrevious" width="120px" class="onbutton"/>
                    <Button text="Next" press="onNext" width="120px" class="onbutton"/>
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
